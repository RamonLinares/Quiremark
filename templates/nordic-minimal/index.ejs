<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteName %> | Home</title>
  <meta name="description" content="<%= siteSubtitle %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="blog-header">
    <div class="header-container">
      <h1 class="logo"><a href="/index.html"><%= siteName %></a></h1>
      <p class="subtitle"><%= siteSubtitle %></p>
    </div>
  </header>

  <div class="main-layout">
    <main class="posts-feed">
      <section class="search-panel" data-search-panel>
        <label class="search-label" for="site-search">Search Archive</label>
        <input id="site-search" class="search-input" type="search" data-search-input placeholder="Search posts, categories, or tags..." autocomplete="off">
        <div class="search-results" data-search-results aria-live="polite"></div>
      </section>

      <% if (posts.length === 0) { %>
        <div class="empty-state">
          <p>No posts published yet.</p>
        </div>
      <% } else { %>
        <% posts.forEach(post => { %>
          <article class="post-card" data-search-card data-search-text="<%= [post.title, post.description, post.category, ...((post.tags || []))].join(' ') %>">
            <% if (post.coverImage) { %>
              <div class="post-image-container">
                <a href="/posts/<%= post.slug %>/index.html">
                  <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-cover" loading="lazy">
                </a>
              </div>
            <% } %>
            <div class="post-meta">
              <span class="post-category"><%= post.category %></span>
              <span class="meta-divider">•</span>
              <span class="post-date"><%= post.date %></span>
            </div>
            <h2 class="post-title">
              <a href="/posts/<%= post.slug %>/index.html"><%= post.title %></a>
            </h2>
            <p class="post-excerpt"><%= post.description %></p>
            <a href="/posts/<%= post.slug %>/index.html" class="read-more">Read Entry →</a>
          </article>
        <% }) %>
      <% } %>
    </main>

    <aside class="blog-sidebar">
      <% widgets.filter(w => w.enabled && w.position === 'sidebar').forEach(widget => { %>
        <div class="widget widget-<%= widget.type %>" id="widget-<%= widget.id %>">
          <h3 class="widget-title"><%= widget.name %></h3>
          
          <% if (widget.type === 'bio') { %>
            <div class="bio-content">
              <% if (authorAvatar) { %>
                <img src="<%= authorAvatar %>" alt="<%= authorName %>" class="bio-avatar">
              <% } %>
              <h4 class="bio-name"><%= authorName %></h4>
              <p class="bio-text"><%= authorBio %></p>
              <div class="bio-socials">
                <% if (socialLinks.github) { %><a href="<%= socialLinks.github %>" target="_blank" rel="noopener">GitHub</a><% } %>
                <% if (socialLinks.twitter) { %><a href="<%= socialLinks.twitter %>" target="_blank" rel="noopener">Twitter</a><% } %>
                <% if (socialLinks.linkedin) { %><a href="<%= socialLinks.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><% } %>
                <% if (socialLinks.instagram) { %><a href="<%= socialLinks.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
              </div>
            </div>
          <% } else if (widget.type === 'recent-posts') { %>
            <ul class="recent-posts-list">
              <% posts.slice(0, 5).forEach(p => { %>
                <li>
                  <a href="/posts/<%= p.slug %>/index.html" class="recent-post-link"><%= p.title %></a>
                  <span class="recent-post-date"><%= p.date %></span>
                </li>
              <% }) %>
            </ul>
          <% } else if (widget.type === 'tag-cloud') { %>
            <div class="tag-cloud">
              <% 
                const tags = {};
                posts.forEach(p => {
                  if (p.tags) p.tags.forEach(t => { tags[t] = (tags[t] || 0) + 1 })
                });
              %>
              <% Object.keys(tags).forEach(tag => { %>
                <span class="tag-chip"><%= tag %> (<%= tags[tag] %>)</span>
              <% }) %>
            </div>
          <% } else if (widget.type === 'custom-html') { %>
            <div class="custom-html">
              <%- widget.htmlContent || '' %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </aside>
  </div>

  <footer class="blog-footer">
    <div class="footer-container">
      <div class="footer-widgets">
        <% widgets.filter(w => w.enabled && w.position === 'footer').forEach(widget => { %>
          <div class="widget widget-<%= widget.type %>" id="widget-<%= widget.id %>">
            <h4 class="widget-title"><%= widget.name %></h4>
            <% if (widget.type === 'newsletter') { %>
              <div class="newsletter-content">
                <p>Subscribe for the latest design & dev updates directly to your inbox.</p>
                <% if (widget.actionUrl) { %>
                  <form class="newsletter-form" action="<%= widget.actionUrl %>" method="post">
                    <input type="email" name="email" placeholder="<%= widget.placeholderText || 'Your email address' %>" required aria-label="Email Address">
                    <button type="submit">Subscribe</button>
                  </form>
                <% } else { %>
                  <form class="newsletter-form">
                    <input type="email" placeholder="<%= widget.placeholderText || 'Configure newsletter endpoint' %>" disabled aria-label="Email Address">
                    <button type="button" disabled>Configure</button>
                  </form>
                <% } %>
              </div>
            <% } else if (widget.type === 'custom-html') { %>
              <div class="custom-html">
                <%- widget.htmlContent || '' %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= siteName %>. All rights reserved.</p>
        <p class="credit">Powered by <a href="#" class="footer-link">ZenithPress</a></p>
      </div>
    </div>
  </footer>
  <script src="/search.js" defer></script>
</body>
</html>
