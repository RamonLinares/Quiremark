<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> | <%= siteName %></title>
  <meta name="description" content="<%= post.description %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="neoglass-theme">
  <!-- Glowing gradient backgrounds -->
  <div class="glow-bg-1"></div>
  <div class="glow-bg-2"></div>

  <header class="blog-header glass-panel">
    <div class="header-container">
      <p class="logo"><a href="/index.html"><%= siteName %></a></p>
      <p class="subtitle"><%= siteSubtitle %></p>
    </div>
  </header>

  <div class="main-layout single-post-layout animate-fade-in">
    <main class="post-detail">
      <nav class="back-nav">
        <a href="/index.html" class="back-link">← Back to Dashboard</a>
      </nav>

      <article class="full-post glass-panel">
        <div class="post-meta">
          <span class="post-category"><%= post.category %></span>
          <span class="meta-divider">•</span>
          <span class="post-date"><%= post.date %></span>
        </div>

        <h1 class="post-title"><%= post.title %></h1>
        <p class="post-description"><%= post.description %></p>

        <% if (post.coverImage) { %>
          <div class="post-cover-container">
            <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-detail-cover">
          </div>
        <% } %>

        <div class="post-content markdown-body">
          <%- post.content %>
        </div>
      </article>
    </main>

    <aside class="blog-sidebar">
      <% widgets.filter(w => w.enabled && w.position === 'sidebar').forEach(widget => { %>
        <div class="widget widget-<%= widget.type %> glass-panel" id="widget-<%= widget.id %>">
          <h3 class="widget-title"><%= widget.name %></h3>

          <% if (widget.type === 'bio') { %>
            <div class="bio-content">
              <% if (authorAvatar) { %>
                <div class="avatar-glow">
                  <img src="<%= authorAvatar %>" alt="<%= authorName %>" class="bio-avatar">
                </div>
              <% } %>
              <h4 class="bio-name"><%= authorName %></h4>
              <p class="bio-text"><%= authorBio %></p>
              <div class="bio-socials">
                <% if (socialLinks.github) { %><a href="<%= socialLinks.github %>" target="_blank" rel="noopener">GitHub</a><% } %>
                <% if (socialLinks.twitter) { %><a href="<%= socialLinks.twitter %>" target="_blank" rel="noopener">Twitter</a><% } %>
                <% if (socialLinks.linkedin) { %><a href="<%= socialLinks.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><% } %>
                <% if (socialLinks.instagram) { %><a href="<%= socialLinks.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
              </div>
            </div>
          <% } else if (widget.type === 'recent-posts') { %>
            <ul class="recent-posts-list">
              <% posts.slice(0, 5).forEach(p => { %>
                <li>
                  <a href="/posts/<%= p.slug %>/index.html" class="recent-post-link"><%= p.title %></a>
                  <span class="recent-post-date"><%= p.date %></span>
                </li>
              <% }) %>
            </ul>
          <% } else if (widget.type === 'tag-cloud') { %>
            <div class="tag-cloud">
              <%
                const tags = {};
                posts.forEach(p => {
                  if (p.tags) p.tags.forEach(t => { tags[t] = (tags[t] || 0) + 1 })
                });
              %>
              <% Object.keys(tags).forEach(tag => { %>
                <span class="tag-chip"><%= tag %> (<%= tags[tag] %>)</span>
              <% }) %>
            </div>
          <% } else if (widget.type === 'custom-html') { %>
            <div class="custom-html">
              <%- widget.htmlContent || '' %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </aside>
  </div>

  <footer class="blog-footer glass-panel">
    <div class="footer-container">
      <div class="footer-widgets">
        <% widgets.filter(w => w.enabled && w.position === 'footer').forEach(widget => { %>
          <div class="widget widget-<%= widget.type %>" id="widget-<%= widget.id %>">
            <h4 class="widget-title"><%= widget.name %></h4>
            <% if (widget.type === 'newsletter') { %>
              <div class="newsletter-content">
                <p>Subscribe for weekly drops of design, coding, and futuristic aesthetics.</p>
                <% if (widget.actionUrl) { %>
                  <form class="newsletter-form" action="<%= widget.actionUrl %>" method="post">
                    <input type="email" name="email" placeholder="<%= widget.placeholderText || 'Email address' %>" required aria-label="Email Address">
                    <button type="submit">Subscribe</button>
                  </form>
                <% } else { %>
                  <form class="newsletter-form">
                    <input type="email" placeholder="<%= widget.placeholderText || 'Configure newsletter endpoint' %>" disabled aria-label="Email Address">
                    <button type="button" disabled>Configure</button>
                  </form>
                <% } %>
              </div>
            <% } else if (widget.type === 'custom-html') { %>
              <div class="custom-html">
                <%- widget.htmlContent || '' %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= siteName %>. All rights reserved.</p>
        <p class="credit">Powered by <a href="#" class="footer-link">ZenithPress</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
